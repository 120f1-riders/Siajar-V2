# Bantuan AI untuk menyusun butir soal.
# Jangan pernah memakai prefix NEXT_PUBLIC_ agar kunci tidak bocor ke browser.

# Gemini dipakai sebagai AI utama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Claude dipakai otomatis bila Gemini gagal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI (GPT) sebagai opsi ketiga bila Gemini dan Claude gagal.
# Bisa juga diarahkan ke gateway OpenAI-compatible seperti ZyRouter.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Alias ZyRouter (dipakai otomatis bila OPENAI_* kosong).
# ZYROUTER_API_KEY=sk-zyr-...
# ZYROUTER_BASE_URL=https://api.zyrouter.com/v1
# ZYROUTER_MODEL=gpt-6-luna

# Database online (wajib saat deploy ke Vercel). Kosongkan untuk memakai file lokal data/siajar.db.
TURSO_DATABASE_URL=libsql://siajar-asyrofimfathan.aws-ap-northeast-1.turso.io
