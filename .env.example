# Bantuan AI untuk menyusun butir soal.
# Jangan pernah memakai prefix NEXT_PUBLIC_ agar kunci tidak bocor ke browser.

# Gemini dipakai sebagai AI utama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Claude dipakai otomatis bila Gemini gagal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Database online (wajib saat deploy ke Vercel). Kosongkan untuk memakai file lokal data/siajar.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Penyimpanan logo & tanda tangan (otomatis terisi saat Vercel Blob dihubungkan ke proyek).
BLOB_READ_WRITE_TOKEN=
