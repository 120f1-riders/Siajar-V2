# Bantuan AI untuk menyusun butir soal (opsional).
# Salin file ini menjadi .env.local, isi kuncinya, lalu jalankan ulang npm run dev.
# Jangan pernah memakai prefix NEXT_PUBLIC_ agar kunci tidak bocor ke browser.

# Kunci API dari penyedia yang kompatibel OpenAI (disarankan Z.ai).
ZAI_API_KEY=4697603c96884b4487b2492be525ad53.FGLjWBrUfLlM04kP

# Alamat API. Untuk Z.ai gunakan nilai berikut.
ZAI_API_BASE=https://api.z.ai/api/paas/v4

# Model yang dipakai. glm-5.3-flash lebih hemat; ganti ke glm-5.3 bila perlu.
ZAI_MODEL=glm-5.3-flash
